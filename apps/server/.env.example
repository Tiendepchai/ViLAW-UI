# Cổng chạy proxy server
PORT=8787

# API base của dự án gốc (service api trong docker-compose.yml của dự án gốc)
# Ví dụ local: http://localhost:8080
# Nếu dự án gốc không dùng /ask, set path cụ thể (vd: /api/ask)
# PROJECT_ASK_PATH=/ask
PROJECT_API_BASE=http://localhost:8080
PROJECT_ASK_PATH=/ask
PROJECT_SEARCH_PATH=/search
# File JSON lưu hội thoại
# - Khi chạy node local: có thể dùng ../../data/conversations.json
# - Khi chạy docker: nên dùng /app/data/conversations.json
DATA_FILE=../../data/conversations.json
