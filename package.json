{
  "name": "datt-chat-ui",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:server": "npm --workspace apps/server run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/server run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
